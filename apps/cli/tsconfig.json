{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@javelin/protocol": ["../../packages/protocol/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../packages/protocol/src/**/*.ts",
    "../../packages/vcs/src/**/*.ts",
    "../../packages/sdk/src/**/*.ts"
  ]
}
